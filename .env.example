# Required
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional — defaults shown
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest

# SQLite database path (local dev). Set to /tmp/chatbot.db on Vercel.
# On Vercel serverless, SQLite data does NOT persist across cold starts.
# Use Vercel Postgres for durable storage in production.
DATABASE_PATH=chatbot.db
